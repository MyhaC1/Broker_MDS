PORT=3003
# Период батча quotes:batch, мс (контракт драйвера сайта ~250)
BATCH_MS=250
BINANCE_WS_URL=wss://stream.binance.com:9443
# Twelve Data (форекс/металлы/акции/индексы). Пусто — вселенная только Binance.
# Бюджет = тариф ключа: free 8/мин и 800/день; PRO — поднять, поллер ускорится сам
TWELVEDATA_API_KEY=
TWELVEDATA_CREDITS_PER_MIN=8
TWELVEDATA_CREDITS_PER_DAY=800

# --- Реестр провайдеров (Р-047, ADR-031) ---
# Файл реестра: какие источники известны, какой включён, кто что ведёт.
# Файла нет -> встроенное умолчание, и оно называет себя умолчанием.
# Файл есть и не читается -> источники НЕ запускаются (fail-closed).
# В контуре путь обязан лежать на томе: иначе переключатель в админке
# работает до первого деплоя.
MDS_REGISTRY_PATH=./data/providers.json

# Секрет служебной ручки /v1/admin/providers. Умолчания НЕТ и быть не может:
# умолчание здесь - это открытая ручка смены источника цены.
# Не задан -> ручка выключена целиком (503), реестр меняется только правкой
# файла. Требования: ASCII без пробелов, не короче 24 символов.
MDS_ADMIN_TOKEN=

# Ключ источника по его id из реестра. Общий вид - именно он делает
# добавление второго источника того же адаптера правкой данных плюс одной
# переменной, а не правкой кода. Пример для id "twelvedata":
# MDS_PROVIDER_KEY_TWELVEDATA=

# Период пересчёта маршрутизации: через него замечается тишина источника
# и происходит failover на запасного.
MDS_ROUTING_RECHECK_MS=5000

# Порог свежести котировки. Умолчания нет сознательно (КОНТРАКТЫ.md 5г):
# не задан -> котировки не отдаются вовсе, /health 503.
QUOTE_STALE_AFTER_MS=60000
